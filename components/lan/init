#!/bin/bash
if [ "$LEGACY" == "no" ]; then
    isolate_docker_iface
fi

# Seed live config paths from baked defaults — compose mounts win.
mkdir -p /etc/default /etc/dhcp
[ -f /etc/default/tftpd-hpa ]    || cp /etc/default.dist/tftpd-hpa    /etc/default/tftpd-hpa
[ -f /etc/dhcp/dhclient.conf ]   || cp /etc/dhcp.dist/dhclient.conf   /etc/dhcp/dhclient.conf
[ -f /sbin/dhclient-script ]     || cp /sbin/dhclient-script.dist     /sbin/dhclient-script
chmod +x /sbin/dhclient-script

count=$((TIMEOUT/5))
for _i in $(seq 1 $count); do
    if ! find /sys/class/net | grep -q -w eth1 ; then
        echo "eth1 interface not found"
        sleep 5
        continue
    fi
    break
done

service tftpd-hpa start
service lighttpd start
# dante-server was removed from Debian trixie; microsocks replaces it as the
# SOCKS5 proxy listening on :8080 (outbound is via OS routing, no "external" knob).
microsocks -i 0.0.0.0 -p 8080 &

/usr/sbin/sshd -D
