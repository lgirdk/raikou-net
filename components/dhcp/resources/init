#! /bin/bash -xe

# Ensure isolation of eth0 interface.
if [ "$LEGACY" == "no" ]; then
    isolate_docker_iface
fi

# Seed /etc/kea/ from baked defaults only if no override is already present
# (compose can bind-mount any of these files; a mount wins and we leave it alone).
mkdir -p /etc/kea
for f in kea-ctrl-agent.conf kea-dhcp4.conf kea-dhcp6.conf keactrl.conf; do
    [ -f "/etc/kea/$f" ] || cp "/etc/kea.dist/$f" "/etc/kea/$f"
done

# Mandatory wait
# The container requires an eth1 interface to run the DHCP server configuration
# Will be stuck in an infinite loop if eth1 interface is not present.
while ! find /sys/class/net -mindepth 1 -maxdepth 1 | grep -q -w eth1; do
    echo "WAN interface \"eth1\" not found"
    sleep 5
done
ip link set eth1 up

# Adding sleep to push configuration files in their places before the server starts.
sleep 15

keactrl start

# Run FAST API only in ENV is set
if [ "$FAST_API" == "yes" ]; then
    python3 /root/kea_api.py &
fi

# By default runs SSH server
if [ $# -gt 0 ]; then
    exec "$@"
else
    /usr/sbin/sshd -D
fi
