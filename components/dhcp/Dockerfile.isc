# DEBIAN DHCP Image start from here.
FROM ssh:v2.0.0

LABEL maintainer="ktewari@libertyglobal.com"
LABEL version=""

ENV DEBIAN_FRONTEND=noninteractive
ENV DNS_UPSTREAM=8.8.8.8
ENV LEGACY="no"

COPY ./resources.isc/init /root/init

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    dnsmasq \
    dnsutils \
    iperf \
    iperf3 \
    iproute2 \
    iptables \
    iputils-ping \
    isc-dhcp-server \
    lighttpd \
    net-tools \
    netcat-openbsd \
    nmap \
    procps \
    psmisc \
    snmp \
    tcpdump \
    tftpd-hpa \
    traceroute \
    tshark \
    vsftpd \
    wget \
    xinetd \
    xxd \
    webfs \
    && rm -rf /var/lib/apt/lists/* && \
    pip --no-cache-dir install pysnmp==4.4.12 && \
    mkdir /tftpboot && \
    rm -rf /var/www/html && \
    ln -s /tftpboot /var/www/html && \
    chmod +x /root/init

# Defaults ship to /etc/dhcp.dist/ and /etc/default.dist/ — init copies any
# missing entry into the live path so a compose mount becomes a true override.
COPY ./resources.isc/dhcpd.conf /etc/dhcp.dist/dhcpd.conf
COPY ./resources.isc/dhcpd6.conf /etc/dhcp.dist/dhcpd6.conf
COPY ./resources.isc/isc-dhcp-server.conf /etc/default.dist/isc-dhcp-server

EXPOSE 69/udp
EXPOSE 80/tcp

CMD ["/bin/bash", "/root/init"]
